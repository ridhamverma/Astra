      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "nodes": {
      "items": {
        "discriminator": {
          "mapping": {
            "decision": "#/$defs/DecisionNode",
            "delay": "#/$defs/DelayNode",
            "process": "#/$defs/ProcessNode",
            "queue": "#/$defs/QueueNode",
            "sink": "#/$defs/SinkNode",
            "source": "#/$defs/SourceNode"
          },
          "propertyName": "type"
