# ==============================================================================
# Astra Frontend Configuration
# ==============================================================================
# Copy this file to frontend/.env.local for local development, or set in your
# Vercel / Netlify / Cloudflare Pages project settings.

# Backend API base URL:
# For local development: http://localhost:8000
# For production (e.g. Render, Railway, Fly.io, AWS): https://your-astra-backend.onrender.com
# Either NEXT_PUBLIC_API_URL or NEXT_PUBLIC_API_BASE_URL can be set.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

