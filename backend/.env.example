# ==============================================================================
# Astra Backend Configuration
# ==============================================================================
# Copy this file to backend/.env for local development or set these variables
# in your cloud hosting provider dashboard (Render, Railway, Fly.io, AWS, etc.).

ASTRA_APP_NAME=Astra API

# Environment: "development" or "production"
# In production, ASTRA_COOKIE_SECURE=true and HTTPS CORS origins are enforced.
ASTRA_ENVIRONMENT=development
# Standard alias: ENVIRONMENT=development

# Database connection:
# Supports managed PostgreSQL (Neon, Supabase, Render, AWS RDS, Railway, etc.)
# Standard aliases: ASTRA_DATABASE_URL or DATABASE_URL
# Supports postgres://, postgresql://, or postgresql+psycopg://
ASTRA_DATABASE_URL=postgresql://astra:change-this-local-password@localhost:5433/astra
# DATABASE_URL=postgresql://user:password@cloud-postgres-host:5432/dbname

# CORS Allowed Origins:
# In production, set to your production frontend URL(s), e.g. https://your-astra.vercel.app
# Supports JSON array (["https://app.vercel.app"]) or comma-separated list (https://app.vercel.app,https://astra.io)
ASTRA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
# Standard alias: CORS_ORIGINS=https://your-astra.vercel.app

# Cookie and Session Security:
# In production with HTTPS, set ASTRA_COOKIE_SECURE=true.
# For cross-site deployments (e.g., Vercel frontend + Render backend on different domains),
# set ASTRA_COOKIE_SAMESITE=none (requires ASTRA_COOKIE_SECURE=true).
# For same-site/custom domain deployments (e.g. app.astra.com + api.astra.com), use "lax".
ASTRA_COOKIE_SECURE=false
ASTRA_COOKIE_SAMESITE=lax
ASTRA_SESSION_HOURS=24

# Authentication & Secret Tokens:
# Astra uses opaque SHA-256 session tokens with Argon2id password hashing in PostgreSQL.
# Optional secret for token rotation or verification.
ASTRA_JWT_SECRET=
# Standard alias: JWT_SECRET=

# AI Model Generation & Result Explanations (Google Gemini):
# Obtain an API key from https://aistudio.google.com/
ASTRA_AI_PROVIDER=gemini
ASTRA_GEMINI_MODEL=gemini-3.1-flash-lite
ASTRA_GEMINI_API_KEY=
# Standard alias: AI_API_KEY= / GEMINI_API_KEY=

